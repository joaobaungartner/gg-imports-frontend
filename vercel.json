{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:resource",
      "destination": "http://44.223.105.77/:resource/"
    },
    {
      "source": "/api/:resource/:path*",
      "destination": "http://44.223.105.77/:resource/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}